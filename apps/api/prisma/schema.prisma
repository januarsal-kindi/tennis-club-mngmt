generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  coach
  member
}

/// Single-row settings table. Seeded once at bootstrap.
model ClubSettings {
  id        Int      @id @default(1)
  name      String
  /// IANA timezone identifier, e.g. "America/New_York" (ARCH-A1)
  timezone  String
  weekStart Int      @default(1) @map("week_start") // 1=Monday, 0=Sunday
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("club_settings")
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  passwordHash           String         @map("password_hash")
  name                   String
  role                   Role           @default(member)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  sessions               Session[]
  bookings               CourtBooking[]
  bookingsCreatedAsAdmin CourtBooking[] @relation("BookingCreatedByAdmin")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TimeBlockKind {
  booking
  session
}

model Court {
  id          String            @id @default(uuid())
  name        String
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  weeklyHours CourtWeeklyHour[]
  blackouts   CourtBlackout[]
  timeBlocks  CourtTimeBlock[]
  bookings    CourtBooking[]

  @@map("courts")
}

model CourtWeeklyHour {
  id         String @id @default(uuid())
  courtId    String @map("court_id")
  weekday    Int
  startLocal String @map("start_local")
  endLocal   String @map("end_local")
  court      Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, weekday])
  @@map("court_weekly_hours")
}

model CourtBlackout {
  id      String   @id @default(uuid())
  courtId String   @map("court_id")
  start   DateTime
  end     DateTime
  reason  String?
  court   Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId])
  @@map("court_blackouts")
}

/// Occupancy holds. `during tstzrange` + gist exclusion live in SQL only (BE-4).
model CourtTimeBlock {
  id        String         @id @default(uuid())
  courtId   String         @map("court_id")
  start     DateTime       @db.Timestamptz(3)
  end       DateTime       @db.Timestamptz(3)
  kind      TimeBlockKind
  refId     String?        @map("ref_id")
  createdAt DateTime       @default(now()) @map("created_at")
  court     Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking   CourtBooking?

  @@index([courtId])
  @@map("court_time_blocks")
}

enum BookingStatus {
  confirmed
  cancelled
}

enum PaymentSubjectType {
  booking
  enrollment
}

enum PaymentStatus {
  unpaid
  pending_verification
  paid
  waived
}

model CourtBooking {
  id               String        @id @default(uuid())
  courtId          String        @map("court_id")
  userId           String        @map("user_id")
  blockId          String?       @unique @map("block_id")
  start            DateTime      @db.Timestamptz(3)
  end              DateTime      @db.Timestamptz(3)
  createdByAdminId String?       @map("created_by_admin_id")
  status           BookingStatus @default(confirmed)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  court            Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  block            CourtTimeBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  createdByAdmin   User?         @relation("BookingCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([courtId])
  @@index([userId])
  @@map("court_bookings")
}

model Payment {
  id          String             @id @default(uuid())
  subjectType PaymentSubjectType @map("subject_type")
  subjectId   String             @map("subject_id")
  status      PaymentStatus      @default(unpaid)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId])
  @@map("payments")
}
