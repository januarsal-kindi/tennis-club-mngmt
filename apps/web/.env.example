# Nest API origin used by next.config rewrites for /api/v1/*
API_ORIGIN=http://localhost:3001

# Server-side origin for middleware GET /api/v1/me (defaults to localhost:3001)
# API_ORIGIN=http://localhost:3001

# Local-demo only: allow offline tc_role fail-open + role picker when API is down.
# In production builds this stays off unless set to true.
# NEXT_PUBLIC_ALLOW_OFFLINE_AUTH=true
