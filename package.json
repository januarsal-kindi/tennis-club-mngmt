{
  "name": "tennis-club",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "dev:api": "pnpm --filter @tennis-club/api dev",
    "lint:api": "pnpm --filter @tennis-club/api lint",
    "lint": "pnpm --filter @tennis-club/api lint && pnpm --filter web lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "prisma"]
  }
}
